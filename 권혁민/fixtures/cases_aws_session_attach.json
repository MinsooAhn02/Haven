      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "post_reference": "AWS-SA-SETUP-P2",
      "logout_then_reuse": true,
      "note": "SEC-19: C가 로그아웃한 뒤 로그아웃 전 세션 쿠키로 P2(공유받은 글) 요청 → 로그인 화면으로 이동"
    }
