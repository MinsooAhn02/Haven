      "category": "crud",
      "method": "POST",
      "path": "/posts/new/",
      "auth_role": "member_a",
      "input_reference": "post_valid_record.json",
      "expected_app": {
        "http_status": 302
      },
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "capture_post_id": true,
      "critical": true,
      "note": "A 시험 게시글 P1 생성"
    },
    {
      "case_id": "AWS-SA-SETUP-P2",
      "phase": 3,
      "category": "crud",
      "method": "POST",
      "path": "/posts/new/",
      "auth_role": "member_a",
      "input_reference": "post_valid_record.json",
      "expected_app": {
        "http_status": 302
      },
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "capture_post_id": true,
      "critical": true,
      "note": "A 시험 게시글 P2 생성(SEC-29 교차 공유용)"
    },
    {
      "case_id": "SEC-18-B-FIXATION-PROBE",
      "phase": 3,
      "category": "session",
      "method": "GET",
      "path": "/posts/{post_id}/",
      "auth_role": "member_b",
      "input_reference": null,
      "expected_app": {
        "http_status": 404
      },
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "post_reference": "AWS-SA-SETUP-P1",
      "session_fixation_probe": true,
      "note": "SEC-18·22: B 로그인 전에 가짜 sessionid를 심고, 로그인 뒤 세션이 교체됐는지와 Secure·HttpOnly·SameSite를 확인(값은 기록하지 않음). 공유 전이라 404"
    },
    {
      "case_id": "SEC-18-C-FIXATION-PROBE",
      "phase": 3,
      "category": "session",
      "method": "GET",
      "path": "/posts/{post_id}/",
      "auth_role": "member_c",
      "input_reference": null,
      "expected_app": {
        "http_status": 404
      },
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "post_reference": "AWS-SA-SETUP-P2",
      "session_fixation_probe": true,
      "note": "SEC-18·22: C도 같은 방식으로 확인. 공유 전이라 404"
    },
    {
      "case_id": "AWS-SA-SHARE-P1-B",
      "phase": 3,
      "category": "sharing",
      "method": "POST",
      "path": "/posts/{post_id}/shares/",
      "auth_role": "member_a",
      "input_reference": "basic_share_grant.json",
      "expected_app": {
        "http_status": 302
      },
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "post_reference": "AWS-SA-SETUP-P1",
      "share_recipient_role": "member_b",
      "critical": true,
      "note": "A가 P1을 B에게 공유"
    },
    {
      "case_id": "AWS-SA-SHARE-P2-C",
      "phase": 3,
      "category": "sharing",
      "method": "POST",
      "path": "/posts/{post_id}/shares/",
      "auth_role": "member_a",
      "input_reference": "basic_share_grant.json",
      "expected_app": {
        "http_status": 302
      },
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
