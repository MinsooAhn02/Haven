      "critical": true,
      "note": "A가 P2를 C에게 공유"
    },
    {
      "case_id": "SEC-30-41-A-UPLOAD",
      "phase": 3,
      "category": "upload",
      "method": "POST",
      "path": "/posts/{post_id}/attachments/",
      "auth_role": "member_a",
      "input_reference": "basic_upload_download_check.json",
      "expected_app": {
        "http_status": 302
      },
      "expected_waf": "NOT_APPLICABLE",
