      "auth_role": "operator",
      "input_reference": "basic_status_enable.json",
      "expected_app": {"http_status": 302},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "비활성 공유 거부 확인 후 C를 다시 활성화"
    },
    {
      "case_id": "SH-05-A-GRANT-P2-C",
      "phase": 2,
      "category": "sharing",
      "method": "POST",
      "path": "/posts/2/shares/",
      "auth_role": "member_a",
      "input_reference": "basic_share_c.json",
      "expected_app": {"http_status": 302},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "A가 P2를 C에게 공유. 초기 공유 ID 2 생성"
