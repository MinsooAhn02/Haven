      "auth_role": "member_a",
      "input_reference": "basic_share_grant.json",
      "expected_app": {"http_status": 302},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "A가 P1을 B에게 공유. 초기 공유 ID 1을 생성하는 사전조건"
    },
    {
      "case_id": "SH-04-OPERATOR-DISABLE-C",
      "phase": 2,
      "category": "admin",
      "method": "POST",
      "path": "/admin/accounts/3/status/",
      "auth_role": "operator",
      "input_reference": "basic_status_disable.json",
      "expected_app": {"http_status": 302},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "공유 대상 검증 전에 일반 회원 C를 비활성화"
    },
    {
      "case_id": "SH-04-A-INACTIVE-TARGET",
      "phase": 2,
