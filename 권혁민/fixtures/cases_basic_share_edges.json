      "input_reference": "basic_share_c.json",
      "expected_app": {"http_status": 400},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "비활성 회원 C에게 공유 시 400. PostShare 행이 생성되지 않아야 함"
    },
    {
      "case_id": "SH-04-OPERATOR-ENABLE-C",
      "phase": 2,
      "category": "admin",
