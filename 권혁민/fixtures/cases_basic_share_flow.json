
{
  "schema_version": 1,
  "suite_id": "haven-basic-share-flow",
  "suite_kind": "regression",
  "cases": [
    {
      "case_id": "SH-01-B-BEFORE",
      "phase": 2,
      "category": "sharing",
      "method": "GET",
      "path": "/posts/1/",
      "auth_role": "member_b",
      "input_reference": null,
      "expected_app": {"http_status": 404},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "공유 전 B는 P1 조회 불가"
    },
    {
      "case_id": "SH-01-A-GRANT",
      "phase": 2,
      "category": "sharing",
      "method": "POST",
      "path": "/posts/1/shares/",
      "auth_role": "member_a",
      "input_reference": "basic_share_grant.json",
      "expected_app": {"http_status": 302},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "A가 B에게 P1 읽기 공유 생성"
    },
    {
      "case_id": "SH-01-B-AFTER",
      "phase": 2,
      "category": "sharing",
      "method": "GET",
      "path": "/posts/1/",
      "auth_role": "member_b",
      "input_reference": null,
      "expected_app": {"http_status": 200},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "공유 후 B는 P1 조회 가능"
    },
    {
      "case_id": "SH-01-C-DENIED",
      "phase": 2,
      "category": "sharing",
      "method": "GET",
      "path": "/posts/1/",
      "auth_role": "member_c",
      "input_reference": null,
      "expected_app": {"http_status": 404},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "미공유 C는 P1 조회 불가"
    },
    {
      "case_id": "SH-02-B-EDIT-POST",
      "phase": 2,
      "category": "authorization",
      "method": "POST",
      "path": "/posts/1/edit/",
      "auth_role": "member_b",
      "input_reference": "post_valid_record.json",
      "expected_app": {"http_status": 404},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "읽기 공유받은 B의 글 수정 거부"
    },
    {
      "case_id": "SH-04-A-DUPLICATE",
      "phase": 2,
      "category": "sharing",
      "method": "POST",
      "path": "/posts/1/shares/",
      "auth_role": "member_a",
      "input_reference": "basic_share_grant.json",
      "expected_app": {"http_status": 302},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "B에게 중복 공유해도 관계가 중복 생성되지 않아야 함"
    },
    {
      "case_id": "SH-04-A-INVALID-TARGETS",
      "phase": 2,
      "category": "sharing",
      "method": "POST",
      "path": "/posts/1/shares/",
      "auth_role": "member_a",
      "input_reference": "basic_share_invalid_variants.json",
      "expected_app": {"http_status": 400},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 4,
      "verification_mode": "manual_required",
      "note": "자기 자신·운영자·없는 사용자·빈 입력 공유 거부"
    },
    {
      "case_id": "SH-05-B-REVOKE-DENIED",
      "phase": 2,
      "category": "authorization",
      "method": "POST",
      "path": "/posts/1/shares/1/revoke/",
      "auth_role": "member_b",
      "input_reference": "post_empty_valid.json",
      "expected_app": {"http_status": 404},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "B는 자신이 공유받은 관계도 해제할 수 없음"
    },
    {
      "case_id": "SH-05-C-REVOKE-DENIED",
      "phase": 2,
      "category": "authorization",
      "method": "POST",
      "path": "/posts/1/shares/1/revoke/",
      "auth_role": "member_c",
      "input_reference": "post_empty_valid.json",
      "expected_app": {"http_status": 404},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "공유받지 않은 C의 공유 해제 거부"
    },
    {
      "case_id": "SH-03-A-REVOKE",
      "phase": 2,
      "category": "sharing",
      "method": "POST",
      "path": "/posts/1/shares/1/revoke/",
      "auth_role": "member_a",
      "input_reference": "post_empty_valid.json",
      "expected_app": {"http_status": 302},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "소유자 A가 B의 P1 공유 해제"
    },
    {
      "case_id": "SH-03-B-AFTER-REVOKE",
      "phase": 2,
      "category": "sharing",
      "method": "GET",
      "path": "/posts/1/",
      "auth_role": "member_b",
      "input_reference": null,
      "expected_app": {"http_status": 404},
      "expected_waf": "NOT_APPLICABLE",
      "max_requests": 1,
      "verification_mode": "manual_required",
      "note": "공유 해제 직후 B의 P1 재접근 거부"
    }
  ]
}
