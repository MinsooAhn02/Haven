{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerminateTaggedHavenInstancesOnly",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:ap-northeast-2:ACCOUNT_ID_MASKED:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:ResourceTag/Project": "Haven",
          "aws:ResourceTag/Owner": "minsung"
        },
        "StringLike": {
          "aws:ResourceTag/Name": "haven-test*"
        }
      }
    }
  ]
}
