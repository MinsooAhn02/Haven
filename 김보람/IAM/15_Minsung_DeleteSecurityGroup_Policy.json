{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeleteHavenSecurityGroupsOnly",
      "Effect": "Allow",
      "Action": "ec2:DeleteSecurityGroup",
      "Resource": "arn:aws:ec2:ap-northeast-2:777171525040:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:ResourceTag/Project": "Haven",
          "aws:ResourceTag/Name": "haven-sg-test"
        }
      }
    }
  ]
}
