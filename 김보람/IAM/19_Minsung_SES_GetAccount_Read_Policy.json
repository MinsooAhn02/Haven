{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "ses:GetAccount",
                "ses:ListRecommendations",
                "ses:ListEmailIdentities"
            ],
            "Resource": "*"
        },
        {
            "Effect": "Allow",
            "Action": "ses:GetEmailIdentity",
            "Resource": "arn:aws:ses:ap-northeast-2:777171525040:identity/*"
        }
    ]
}
