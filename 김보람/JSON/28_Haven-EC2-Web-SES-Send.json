{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendHavenEmail",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "arn:aws:ses:ap-northeast-2:777171525040:identity/orchestration-haven.cloud",
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "noreply@orchestration-haven.cloud",
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    }
  ]
}
