{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendHavenEmail",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": [
        "arn:aws:ses:ap-northeast-2:${ACCOUNT_ID}:identity/orchestration-haven.cloud",
        "arn:aws:ses:ap-northeast-2:${ACCOUNT_ID}:identity/kkuik@naver.com"
      ],
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "noreply@orchestration-haven.cloud",
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    }
  ]
}
