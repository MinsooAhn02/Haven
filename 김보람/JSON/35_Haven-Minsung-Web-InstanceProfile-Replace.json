{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReplaceWebInstanceProfileInSeoul",
      "Effect": "Allow",
      "Action": "ec2:ReplaceIamInstanceProfileAssociation",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    }
  ]
}
