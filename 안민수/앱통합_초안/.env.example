# Haven 앱 환경변수 예시 (신요찬/앱계약.md 1.2). placeholder만 둔다 — 실제 값은 여기에 쓰지 않는다.
# 앱은 .env 파일을 자동으로 읽지 않는다. 각자 셸에서 환경변수로 설정한다.
#   PowerShell 예: $env:DJANGO_SECRET_KEY = "<로컬 개발용 임의 문자열>"
# 필수값이 없으면 앱은 시작에 실패한다(SQLite 대체 없음).

DJANGO_SECRET_KEY=<로컬 개발용 임의 문자열>
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# HTTPS 배포 때만
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_NAME=haven_dev
DB_USER=haven_owner
DB_PASSWORD=<각자 개발 DB 비밀번호>
DB_HOST=localhost
DB_PORT=5432

# 선택: 템플릿·static 위치를 바꿀 때만
HAVEN_TEMPLATES_DIR=
HAVEN_STATIC_DIR=
# seed_demo 실행 때만
HAVEN_SEED_PASSWORD=<가상 계정 비밀번호>
